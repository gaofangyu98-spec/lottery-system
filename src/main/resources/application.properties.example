# =========================
# ???? application.properties ???????????
# =========================
server.port=8082

# MySQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://YOUR_MYSQL_HOST:3306/lottery_system?characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_USERNAME
spring.datasource.password=YOUR_PASSWORD

# MyBatis
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.type-handlers-package=com.example.lotterysystem.dao.handler

# ??
logging.config=classpath:logback-spring.xml

# ?????
sms.access-key-id=YOUR_ACCESS_KEY_ID
sms.access-key-secret=YOUR_ACCESS_KEY_SECRET
sms.sign-name=YOUR_SIGN_NAME

# Redis
spring.data.redis.host=YOUR_REDIS_HOST
spring.data.redis.port=6379
spring.data.redis.timeout=60s
spring.data.redis.lettuce.pool.max-active=8
spring.data.redis.lettuce.pool.max-idle=8
spring.data.redis.lettuce.pool.min-idle=0
spring.data.redis.lettuce.pool.max-wait=5s

# ????
pic.local-path=/path/to/pic
spring.web.resources.static-locations=classpath:/static/,file:${pic.local-path}

# JWTjwt.secret=YOUR_BASE64_SECRET_KEYjwt.expiration=3600000# RabbitMQ
spring.rabbitmq.host=YOUR_RABBITMQ_HOST
spring.rabbitmq.port=5672
spring.rabbitmq.username=YOUR_USERNAME
spring.rabbitmq.password=YOUR_PASSWORD
spring.rabbitmq.listener.simple.acknowledge-mode=auto
spring.rabbitmq.listener.simple.retry.enabled=true
spring.rabbitmq.listener.simple.retry.max-attempts=5

# ??
spring.mail.host=smtp.qq.com
spring.mail.username=YOUR_EMAIL@qq.com
spring.mail.password=YOUR_AUTH_CODE
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.ssl.enable=false

# ?????
async.executor.thread.core_pool_size=10
async.executor.thread.max_pool_size=20
async.executor.thread.queue_capacity=20
async.executor.thread.name.prefix=async-service-
